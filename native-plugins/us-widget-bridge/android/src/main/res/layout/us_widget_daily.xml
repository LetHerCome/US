<?xml version="1.0" encoding="utf-8"?>
<!-- La domanda di oggi 2x2, Pastello (approved board, 02/11/2026): the white
     "Oggi" label, the question in Figtree extra bold, who has answered with
     that person's dot. Never an answer. Ids are stable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_daily_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_pastel_daily"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="14dp"
    android:paddingEnd="15dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/us_daily_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/us_widget_pastel_pill"
        android:fontFamily="@font/us_figtree"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:letterSpacing="0.02"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="@string/us_widget_daily_pill"
        android:textColor="@color/us_widget_pastel_plum"
        android:textFontWeight="800"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/us_daily_question"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/us_figtree"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="4"
        android:text="@string/us_widget_daily_open"
        android:textColor="@color/us_widget_pastel_plum"
        android:textFontWeight="800"
        android:textSize="15.5sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/us_daily_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/us_widget_pastel_dot"
            android:visibility="gone" />

        <TextView
            android:id="@+id/us_daily_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/us_figtree"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/us_widget_pastel_sub"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
