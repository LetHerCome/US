<?xml version="1.0" encoding="utf-8"?>
<!-- La domanda di oggi 2x2 (widget del redesign, 26/11/2026): the label, the
     question in Fraunces as big as it fits, «Rispondi». Never an answer. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_daily_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_w_card"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/us_daily_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/us_figtree"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/us_widget_daily_kicker"
            android:textColor="@color/us_w_label"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/us_daily_question"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitStart" />

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="36dp"
            android:layout_gravity="end">

            <ImageView
                android:id="@+id/us_daily_pill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/us_daily_answer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/us_figtree"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/us_widget_daily_answer"
                android:textColor="@color/us_w_on_pill"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
