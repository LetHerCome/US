<?xml version="1.0" encoding="utf-8"?>
<!-- Foto & giorni 4x2, Pastello: the photo with a veil from the left, your
     two portraits, the days together in Fraunces and "dal 21 aprile ·
     Lisbona, 12 ottobre" (since when, where and when the photo is). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_photo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_pastel_photo_empty"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/us_photo_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/us_photo_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/us_widget_pastel_scrim_left" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:layout_width="62dp"
            android:layout_height="34dp">

            <ImageView
                android:id="@+id/us_photo_me"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/us_widget_pastel_circle" />

            <ImageView
                android:id="@+id/us_photo_partner"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="26dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/us_widget_pastel_circle" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/us_photo_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/us_fraunces"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:textColor="@color/us_widget_text"
            android:textSize="58sp" />

        <TextView
            android:id="@+id/us_photo_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/us_fraunces"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/us_widget_text"
            android:textSize="16sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/us_photo_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/us_figtree"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#C7F7EFE9"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/us_photo_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/us_figtree"
            android:importantForAccessibility="no"
            android:text="@string/us_widget_photo_empty"
            android:textColor="#E6F7EFE9"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
