<?xml version="1.0" encoding="utf-8"?>
<!-- La domanda di oggi 4x2 (picker preview): the label in Noi's orchid, the
     question in serif (three lines at most) and one italic line on whose
     turn it is. Same background and colours as the other US widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_daily_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:letterSpacing="0.14"
        android:maxLines="1"
        android:text="@string/us_widget_daily_name"
        android:textAllCaps="true"
        android:textColor="@color/us_widget_orchidea"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/us_daily_preview_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.08"
        android:maxLines="3"
        android:text="@string/us_widget_daily_preview_question"
        android:textColor="@color/us_widget_text"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/us_daily_preview_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="serif"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/us_widget_daily_todo"
        android:textColor="@color/us_widget_muted"
        android:textSize="13sp"
        android:textStyle="italic" />
</LinearLayout>
