<?xml version="1.0" encoding="utf-8"?>
<!-- Post-it 2x2 (widget del redesign, 26/11/2026): the newest post-it, its
     paper (paper in both themes) turned a little on the card, the tape in the
     colour of whoever wrote it, and how many others. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_postit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_w_card"
    android:clipToOutline="true">

    <FrameLayout
        android:id="@+id/us_postit_paper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="18dp"
        android:background="@drawable/us_widget_postit_yellow"
        android:elevation="3dp"
        android:paddingStart="12dp"
        android:paddingTop="18dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:rotation="2">

        <ImageView
            android:id="@+id/us_postit_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <ImageView
        android:id="@+id/us_postit_tape"
        android:layout_width="46dp"
        android:layout_height="16dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:alpha="0.8"
        android:contentDescription="@null"
        android:elevation="4dp"
        android:importantForAccessibility="no"
        android:rotation="3"
        android:scaleType="fitXY"
        android:src="@drawable/us_w_tape" />

    <TextView
        android:id="@+id/us_postit_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/us_figtree"
        android:importantForAccessibility="no"
        android:textColor="@color/us_w_sub"
        android:textSize="11sp"
        android:textStyle="bold" />
</FrameLayout>
