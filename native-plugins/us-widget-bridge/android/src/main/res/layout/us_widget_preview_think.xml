<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+). Generic: no real names. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:letterSpacing="0.14"
        android:text="@string/us_widget_cta"
        android:textAllCaps="true"
        android:textColor="@color/us_widget_rosa"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="@string/us_widget_preview_think"
        android:textColor="@color/us_widget_text"
        android:textSize="18sp" />

    <ImageView
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:importantForAccessibility="no"
        android:scaleType="centerInside"
        android:src="@drawable/us_widget_heart" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/us_widget_pill_rosa"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.12"
        android:minWidth="88dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/us_widget_preview_think_cta"
        android:textAllCaps="true"
        android:textColor="@color/us_widget_rosa"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
