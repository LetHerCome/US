<?xml version="1.0" encoding="utf-8"?>
<!-- Lasciato per te 2x2, Foto protagonista (founder, 02/11/2026): an
     illustrated envelope, the partner's small portrait, and a little sealed
     note in Fraunces ("Ti ha lasciato una foto", "da Bea · 10 min fa"). The
     surprise stays closed: only the kind and the time. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_message_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_card"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/us_message_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/us_widget_art_message_s" />

    <FrameLayout
        android:id="@+id/us_message_grain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/us_widget_grain" />

    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp">

        <ImageView
            android:id="@+id/us_message_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/us_widget_art_field" />

        <ImageView
            android:id="@+id/us_message_initial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <!-- The note, a little tilted, with its rosa seal on the corner. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:layout_gravity="bottom"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/us_widget_note"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:rotation="-3">

            <ImageView
                android:id="@+id/us_message_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitStart" />

            <TextView
                android:id="@+id/us_message_when"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="@font/us_figtree"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/us_widget_pastel_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/us_message_seal"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-8dp"
            android:layout_marginEnd="-10dp"
            android:background="@drawable/us_widget_seal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/us_widget_pastel_heart"
                android:tint="@android:color/white" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
