<?xml version="1.0" encoding="utf-8"?>
<!-- Lasciato per te 2x2 (founder, 04/11/2026): a letter. Who left you
     something and how long ago, in Fraunces at the top; the sealed envelope
     is the art below. Never the words, photo or link. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_message_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_card"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/us_message_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/us_widget_art_message_s" />

    <FrameLayout
        android:id="@+id/us_message_grain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/us_widget_grain" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/us_message_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitStart" />

        <TextView
            android:id="@+id/us_message_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/us_figtree"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/us_widget_pastel_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/us_message_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/us_figtree"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/us_widget_pastel_sub"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
