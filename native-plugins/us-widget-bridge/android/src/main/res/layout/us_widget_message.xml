<?xml version="1.0" encoding="utf-8"?>
<!-- Lasciato per te 2x2, Pastello (approved board, 02/11/2026): the
     partner's portrait, a white bubble with what they left ("Ti ha lasciato
     una foto"), how long ago and the rosa envelope. Never the content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_message_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_pastel_left"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/us_message_photo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/us_widget_pastel_circle" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/us_message_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/us_widget_pastel_bubble"
        android:ellipsize="end"
        android:fontFamily="@font/us_fraunces"
        android:importantForAccessibility="no"
        android:lineSpacingMultiplier="1.05"
        android:maxLines="2"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:textColor="@color/us_widget_pastel_ink"
        android:textSize="16sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/us_message_when"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/us_figtree"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/us_widget_pastel_sub"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/us_widget_pastel_envelope" />
    </LinearLayout>
</LinearLayout>
