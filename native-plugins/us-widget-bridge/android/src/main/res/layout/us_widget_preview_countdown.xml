<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+), base style. Generic title. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:letterSpacing="0.14"
        android:maxLines="1"
        android:text="@string/us_widget_preview_countdown"
        android:textAllCaps="true"
        android:textColor="@color/us_widget_corallo"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="serif"
        android:includeFontPadding="false"
        android:text="@string/us_widget_preview_countdown_value"
        android:textColor="@color/us_widget_text"
        android:textSize="58sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="serif"
        android:includeFontPadding="false"
        android:text="@string/us_widget_preview_countdown_unit"
        android:textColor="@color/us_widget_text_2"
        android:textSize="16sp"
        android:textStyle="italic" />
</LinearLayout>
