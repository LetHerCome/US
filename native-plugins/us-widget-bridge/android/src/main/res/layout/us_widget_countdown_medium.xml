<?xml version="1.0" encoding="utf-8"?>
<!-- Countdown 4x2, Pastello: the sky with the night scrim, "Lisbona · 14
     novembre", the number in Fraunces latte with "giorni" and the hours, and
     14 ticks for the last two weeks (the days gone are lit). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_cd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_pastel_countdown_sky"
    android:contentDescription="@string/us_widget_countdown_name"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/us_cd_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/us_cd_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/us_widget_pastel_pill_glass"
            android:ellipsize="end"
            android:fontFamily="@font/us_figtree"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
            android:textColor="@color/us_widget_text"
            android:textFontWeight="800"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/us_cd_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/us_fraunces"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/us_widget_text"
                android:textSize="60sp" />

            <Chronometer
                android:id="@+id/us_cd_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/us_fraunces"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/us_widget_text"
                android:textSize="44sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/us_cd_unit_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/us_cd_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/us_fraunces"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/us_widget_text"
                    android:textSize="18sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/us_cd_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/us_figtree"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#CCF7EFE9"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:orientation="horizontal">

            <ImageView android:id="@+id/us_cd_tick_0" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_1" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_2" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_3" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_4" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_5" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_6" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_7" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_8" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_9" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_10" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_11" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_12" style="@style/UsWidgetTick" />
            <ImageView
                android:id="@+id/us_cd_tick_13"
                style="@style/UsWidgetTick"
                android:layout_marginEnd="0dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/us_cd_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="@font/us_fraunces"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/us_widget_text"
        android:textSize="16sp"
        android:textStyle="italic"
        android:visibility="gone" />
</FrameLayout>
