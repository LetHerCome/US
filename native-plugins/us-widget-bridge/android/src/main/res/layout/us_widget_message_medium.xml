<?xml version="1.0" encoding="utf-8"?>
<!-- Lasciato per te 4x2, Foto protagonista: the big illustrated envelope on
     the left, the partner's small portrait, and on the right the sealed note
     in Fraunces with "da Bea · 10 min fa"; under it "la scopri solo dentro US". -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_message_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_card"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/us_message_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/us_widget_art_message_m" />

    <FrameLayout
        android:id="@+id/us_message_grain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/us_widget_grain" />

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp">

        <ImageView
            android:id="@+id/us_message_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/us_widget_art_field" />

        <ImageView
            android:id="@+id/us_message_initial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:orientation="vertical"
        android:paddingEnd="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingTop="10dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/us_widget_note"
                android:orientation="vertical"
                android:paddingStart="13dp"
                android:paddingTop="11dp"
                android:paddingEnd="13dp"
                android:paddingBottom="11dp"
                android:rotation="-3">

                <ImageView
                    android:id="@+id/us_message_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitStart" />

                <TextView
                    android:id="@+id/us_message_who"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/us_figtree"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/us_widget_pastel_sub"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/us_message_seal"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-8dp"
                android:layout_marginEnd="-8dp"
                android:background="@drawable/us_widget_seal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/us_widget_pastel_heart"
                    android:tint="@android:color/white" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/us_message_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/us_figtree"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/us_widget_pastel_sub"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
