<?xml version="1.0" encoding="utf-8"?>
<!-- Lasciato per te 4x2 (widget del redesign, 26/11/2026): the label, what it
     is in Fraunces, «si apre solo in US» and when; the envelope on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_message_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_w_card"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/us_message_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/us_figtree"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/us_widget_message_name"
                android:textColor="@color/us_w_label"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/us_message_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/us_message_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/us_figtree"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/us_w_sub"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/us_message_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/us_figtree"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/us_w_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/us_message_envelope"
            android:layout_width="140dp"
            android:layout_height="93dp"
            android:layout_marginStart="8dp"
            android:rotation="-4">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/us_w_envelope" />

            <ImageView
                android:id="@+id/us_message_stripe"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/us_w_envelope_stripe" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
