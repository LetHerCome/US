<?xml version="1.0" encoding="utf-8"?>
<!-- Lasciato per te 4x2, Pastello: the portrait on the left, the bubble with
     what they left and "la scopri solo dentro US", then "Bea · 10 min fa"
     and the rosa "Apri" pill. Never the content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_message_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_pastel_left"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <ImageView
        android:id="@+id/us_message_photo"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/us_widget_pastel_circle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/us_widget_pastel_bubble"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/us_message_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/us_fraunces"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/us_widget_pastel_ink"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/us_message_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/us_figtree"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/us_widget_pastel_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/us_message_who"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/us_figtree"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/us_widget_pastel_sub"
                android:textSize="11.5sp" />

            <LinearLayout
                android:id="@+id/us_message_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/us_widget_pastel_pill_rosa"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/us_widget_pastel_envelope"
                    android:tint="@color/us_widget_pastel_ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/us_figtree"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="@string/us_widget_message_open"
                    android:textColor="@color/us_widget_pastel_ink"
                    android:textFontWeight="800"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
