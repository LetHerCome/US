<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+), Messaggio. Generic: no face, no name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <ImageView
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="3dp"
        android:importantForAccessibility="no"
        android:src="@drawable/us_widget_portrait_lilla" />

    <ImageView
        android:layout_width="12dp"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/us_widget_bubble_tail_up" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/us_widget_bubble"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/us_widget_heart"
            android:tint="@color/us_widget_rosa" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/us_widget_preview_message"
                android:textColor="@color/us_widget_bg"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/us_widget_preview_message_when"
                android:textColor="#A60F0B13"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
