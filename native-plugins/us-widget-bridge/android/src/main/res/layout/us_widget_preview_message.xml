<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+), Lasciato per te in Pastello.
     Generic: a lilla circle without a face, every text from strings.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_pastel_left"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/us_widget_pastel_circle"
        android:tint="@color/us_widget_lilla" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/us_widget_pastel_bubble"
        android:fontFamily="@font/us_fraunces"
        android:maxLines="2"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/us_widget_preview_message"
        android:textColor="@color/us_widget_pastel_ink"
        android:textSize="16sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/us_figtree"
            android:includeFontPadding="false"
            android:text="@string/us_widget_preview_message_when"
            android:textColor="@color/us_widget_pastel_sub"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/us_widget_pastel_envelope" />
    </LinearLayout>
</LinearLayout>
