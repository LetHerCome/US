<?xml version="1.0" encoding="utf-8"?>
<!-- NOI V2: compact 2x1 invitation. Root opens Noi; action opens Gioca. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_noi_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_background"
    android:contentDescription="@string/us_widget_noi_name"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="9dp"
    android:paddingEnd="10dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/us_noi_accent"
            android:layout_width="12dp"
            android:layout_height="3dp"
            android:layout_marginEnd="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/us_widget_noi_ring"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="US · NOI"
            android:textColor="@color/us_widget_muted"
            android:textSize="9sp"/>

        <TextView
            android:id="@+id/us_noi_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/us_widget_accent"
            android:textSize="9sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/us_noi_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/us_widget_text"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/us_noi_cta"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:minWidth="54dp"
            android:background="@drawable/us_widget_noi_action"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/us_widget_text"
            android:textSize="10sp"/>
    </LinearLayout>
</LinearLayout>
