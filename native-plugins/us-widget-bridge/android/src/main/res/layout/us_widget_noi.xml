<?xml version="1.0" encoding="utf-8"?>
<!-- Distanza e batteria 2x1 (the Noi placed before as 2x1), Foto protagonista:
     the illustration under your two small portraits, the distance in Fraunces,
     the partner's battery or how old the reading is. Ids are stable: widgets
     already on a Home screen keep working. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_noi_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_card"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/us_noi_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/us_widget_art_noi_m" />

    <FrameLayout
        android:id="@+id/us_noi_grain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/us_widget_grain" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp">

            <ImageView
                android:id="@+id/us_noi_me"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/us_widget_art_field" />

            <ImageView
                android:id="@+id/us_noi_me_initial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="-8dp"
            android:layout_marginEnd="10dp">

            <ImageView
                android:id="@+id/us_noi_partner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/us_widget_art_field" />

            <ImageView
                android:id="@+id/us_noi_partner_initial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/us_noi_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitStart" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/us_noi_battery_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/us_widget_battery_high"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/us_noi_battery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/us_figtree"
                    android:fontFeatureSettings="tnum"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/us_widget_pastel_sub"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
