<?xml version="1.0" encoding="utf-8"?>
<!-- Ricordi a pila 2x2, Pastello (approved board, 02/11/2026): the stack of
     three prints drawn by US, then the place in Fraunces and the short day. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_mem_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_pastel_memories"
    android:contentDescription="@string/us_widget_memories_name">

    <LinearLayout
        android:id="@+id/us_mem_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/us_mem_stack"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/us_mem_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/us_fraunces"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/us_widget_pastel_ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/us_mem_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/us_figtree"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/us_widget_pastel_sub"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/us_mem_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="@font/us_fraunces"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:padding="16dp"
        android:textColor="@color/us_widget_pastel_ink"
        android:textSize="15sp"
        android:textStyle="italic"
        android:visibility="gone" />
</FrameLayout>
