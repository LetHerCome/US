<?xml version="1.0" encoding="utf-8"?>
<!-- Ti penso 4x2, Pastello: portrait, "Bea ti ha pensato" and how long ago;
     under a hairline how many times the two of you thought of each other
     today; on the right the big heart button and "Ricambia". -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_pastel_think"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/us_think_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/us_widget_pastel_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/us_widget_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/us_fraunces"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text="@string/us_widget_cta"
                        android:textColor="@color/us_widget_pastel_ink"
                        android:textSize="21sp" />

                    <TextView
                        android:id="@+id/us_think_when"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/us_figtree"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/us_widget_pastel_sub"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/us_widget_pastel_line" />

            <LinearLayout
                android:id="@+id/us_think_count_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/us_think_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/us_fraunces"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:textColor="@color/us_widget_rosa"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/us_think_count_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/us_figtree"
                    android:importantForAccessibility="no"
                    android:maxLines="2"
                    android:textColor="@color/us_widget_pastel_sub"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/us_widget_heart_button"
                android:layout_width="84dp"
                android:layout_height="84dp">

                <ImageView
                    android:id="@+id/us_widget_heart_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/us_widget_pastel_circle" />

                <ImageView
                    android:id="@+id/us_widget_heart"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/us_widget_send"
                    android:src="@drawable/us_widget_pastel_heart" />
            </FrameLayout>

            <TextView
                android:id="@+id/us_widget_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/us_figtree"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/us_widget_cta"
                android:textColor="@color/us_widget_pastel_ink"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
