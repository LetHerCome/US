<?xml version="1.0" encoding="utf-8"?>
<!-- Ti penso 4x2 (widget del redesign, 26/11/2026): you two, the heart
     between you, «Un pensiero, un tocco»; the whole widget sends. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_w_card"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="20dp">

        <FrameLayout
            android:layout_width="156dp"
            android:layout_height="132dp">

            <ImageView
                android:id="@+id/us_think_me"
                android:layout_width="88dp"
                android:layout_height="85dp"
                android:layout_gravity="bottom|start"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/us_think_partner"
                android:layout_width="81dp"
                android:layout_height="78dp"
                android:layout_gravity="bottom|end"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/us_widget_heart"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/us_think_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/us_think_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/us_figtree"
                android:importantForAccessibility="no"
                android:maxLines="2"
                android:textColor="@color/us_w_sub"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
