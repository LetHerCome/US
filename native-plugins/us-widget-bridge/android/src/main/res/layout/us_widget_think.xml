<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/us_widget_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:textColor="@color/us_widget_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/us_widget_heart"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@string/us_widget_send"
        android:scaleType="centerInside"
        android:src="@drawable/us_widget_heart" />

    <TextView
        android:id="@+id/us_widget_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:text="@string/us_widget_cta"
        android:textAllCaps="true"
        android:textColor="@color/us_widget_accent"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
