<?xml version="1.0" encoding="utf-8"?>
<!-- Ti penso 2x2, Pastello (approved board, 02/11/2026): the partner's
     portrait and how long ago, "Bea ti ha pensato" in Fraunces, the heart
     button at the bottom right. Class and layout names are stable, so a
     widget already on a Home screen keeps working. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_pastel_think"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/us_think_avatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/us_widget_pastel_circle" />

            <TextView
                android:id="@+id/us_think_when"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/us_figtree"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/us_widget_pastel_sub"
                android:textSize="11.5sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/us_widget_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="52dp"
            android:ellipsize="end"
            android:fontFamily="@font/us_fraunces"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.05"
            android:maxLines="3"
            android:text="@string/us_widget_cta"
            android:textColor="@color/us_widget_pastel_ink"
            android:textSize="19sp" />
    </LinearLayout>

    <!-- The heart button: white with a rosa heart; full rosa with a white heart once tapped. -->
    <FrameLayout
        android:id="@+id/us_widget_heart_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="-4dp">

        <ImageView
            android:id="@+id/us_widget_heart_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/us_widget_pastel_circle" />

        <ImageView
            android:id="@+id/us_widget_heart"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/us_widget_send"
            android:src="@drawable/us_widget_pastel_heart" />
    </FrameLayout>
</FrameLayout>
