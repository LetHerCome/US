<?xml version="1.0" encoding="utf-8"?>
<!-- Ti penso 2x2 (widget del redesign, founder 26/11/2026): the heart from
     your colour to theirs, the only place with the two blended, and «Pensa a
     Bea». When their thought arrives: their character in love and «Bea ti
     pensa»; a tap answers it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_w_card"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/us_think_send"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/us_widget_heart"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/us_think_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/us_figtree"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/us_w_sub"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/us_think_got"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/us_think_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/us_think_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/us_figtree"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/us_w_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/us_think_partner"
            android:layout_width="96dp"
            android:layout_height="93dp"
            android:layout_gravity="bottom|center_horizontal"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/us_think_badge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="76dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </FrameLayout>
</FrameLayout>
