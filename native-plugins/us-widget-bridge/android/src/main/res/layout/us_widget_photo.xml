<?xml version="1.0" encoding="utf-8"?>
<!-- Foto & giorni 2x2, Pastello (approved board, 02/11/2026): Oggi's photo of
     this hour, a veil at the bottom, the three hourly photos as bars on top,
     the days together in Fraunces. Ids are stable: placed widgets keep working. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_photo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_pastel_photo_empty"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/us_photo_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/us_photo_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/us_widget_pastel_scrim_bottom" />

    <LinearLayout
        android:id="@+id/us_photo_bars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/us_photo_bar_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/us_widget_pastel_bar_on" />

        <ImageView
            android:id="@+id/us_photo_bar_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/us_widget_pastel_bar_off" />

        <ImageView
            android:id="@+id/us_photo_bar_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/us_widget_pastel_bar_off" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/us_photo_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/us_figtree"
            android:importantForAccessibility="no"
            android:text="@string/us_widget_photo_empty"
            android:textColor="#E6F7EFE9"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/us_photo_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/us_fraunces"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:textColor="@color/us_widget_text"
            android:textSize="52sp" />

        <TextView
            android:id="@+id/us_photo_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/us_fraunces"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#EBF7EFE9"
            android:textSize="15sp"
            android:textStyle="italic" />
    </LinearLayout>
</FrameLayout>
