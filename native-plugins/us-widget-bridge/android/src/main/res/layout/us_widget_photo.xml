<?xml version="1.0" encoding="utf-8"?>
<!-- Foto & Noi: the same Oggi hero image (private on-device cache) and the
     days together, the number in serif and its unit in italic as in Oggi. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_photo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_background"
    android:contentDescription="@string/us_widget_photo_name">

    <ImageView
        android:id="@+id/us_photo_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/us_photo_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/us_widget_photo_scrim"
        android:visibility="gone" />

    <!-- No photo yet: the two colours and one calm line, above the days. -->
    <LinearLayout
        android:id="@+id/us_photo_placeholder_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="54dp">

        <TextView
            android:id="@+id/us_photo_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableTop="@drawable/us_widget_two_dots"
            android:drawablePadding="10dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="3"
            android:text="@string/us_widget_photo_empty"
            android:textColor="@color/us_widget_text_2"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/us_photo_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#990F0B13"
            android:shadowRadius="8"
            android:textColor="@color/us_widget_text"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/us_photo_unit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:shadowColor="#990F0B13"
            android:shadowRadius="8"
            android:textColor="@color/us_widget_text"
            android:textSize="14sp"
            android:textStyle="italic" />
    </LinearLayout>
</FrameLayout>
