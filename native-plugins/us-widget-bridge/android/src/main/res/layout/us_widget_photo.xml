<?xml version="1.0" encoding="utf-8"?>
<!-- Foto & Noi: the same Oggi hero image (private on-device cache) and days together. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_photo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_background"
    android:contentDescription="@string/us_widget_photo_name">

    <ImageView
        android:id="@+id/us_photo_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/us_photo_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/us_widget_photo_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/us_photo_placeholder_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="34dp">

        <TextView
            android:id="@+id/us_photo_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableTop="@drawable/us_widget_image"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="3"
            android:text="@string/us_widget_photo_empty"
            android:textColor="@color/us_widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/us_photo_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowRadius="6"
            android:textColor="@color/us_widget_text"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/us_photo_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="3dp"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowRadius="6"
            android:textColor="@color/us_widget_text"
            android:textSize="13sp"
            android:textStyle="italic" />
    </LinearLayout>
</FrameLayout>
