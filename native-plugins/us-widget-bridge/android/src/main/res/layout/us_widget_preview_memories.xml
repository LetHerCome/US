<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+), Ricordi a pila in Pastello.
     Generic: three coloured prints, no photo; every text from strings.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_pastel_memories">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:importantForAccessibility="no"
        android:rotation="-9"
        android:src="@drawable/us_widget_pastel_print_sky" />

    <ImageView
        android:layout_width="96dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:importantForAccessibility="no"
        android:rotation="7"
        android:src="@drawable/us_widget_pastel_print_sun" />

    <ImageView
        android:layout_width="96dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/us_widget_pastel_print_rose" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/us_fraunces"
            android:includeFontPadding="false"
            android:text="@string/us_widget_preview_memories"
            android:textColor="@color/us_widget_pastel_ink"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/us_figtree"
            android:includeFontPadding="false"
            android:text="@string/us_widget_preview_memories_date"
            android:textColor="@color/us_widget_pastel_sub"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
