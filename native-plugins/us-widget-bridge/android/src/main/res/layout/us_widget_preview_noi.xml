<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+), Noi stile mappa. Generic: the two
     colours without faces, no names, every text from strings.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_background"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/us_widget_noi_map_v1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:text="@string/us_widget_noi_name"
            android:textAllCaps="true"
            android:textColor="@color/us_widget_orchidea"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom|end"
            android:orientation="vertical">

            <TextView
                style="@style/UsWidgetBubble"
                android:text="@string/us_widget_preview_bubble" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="6dp"
                android:layout_marginEnd="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/us_widget_bubble_tail" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/us_widget_portrait_rosa" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/us_widget_preview_noi"
                    android:textColor="@color/us_widget_text"
                    android:textSize="19sp" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="4dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/us_widget_dashed_line" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/us_widget_noi_between"
                    android:textColor="@color/us_widget_text_2"
                    android:textSize="12sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_margin="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/us_widget_portrait_lilla" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:importantForAccessibility="no"
                android:src="@drawable/us_widget_battery_medium"
                android:tint="@color/us_widget_text_2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/us_widget_preview_battery"
                android:textColor="@color/us_widget_text_2"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
