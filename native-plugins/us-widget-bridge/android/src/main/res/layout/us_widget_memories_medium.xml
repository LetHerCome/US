<?xml version="1.0" encoding="utf-8"?>
<!-- Ricordi a pila 4x2, Foto protagonista: a fan of your three prints (drawn
     by US) on a soft field, and beside it "Un anno fa", the title in Fraunces
     and "2 novembre · 8 foto". Without memories, empty prints drawn by hand. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_mem_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_card"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/us_mem_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/us_widget_art_memories_back" />

    <FrameLayout
        android:id="@+id/us_mem_grain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/us_widget_grain" />

    <LinearLayout
        android:id="@+id/us_mem_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/us_mem_stack"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/us_mem_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/us_widget_glass_pill"
                android:ellipsize="end"
                android:fontFamily="@font/us_figtree"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/us_widget_pastel_ink"
                android:textSize="11sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/us_mem_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitStart" />

            <TextView
                android:id="@+id/us_mem_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="@font/us_figtree"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/us_widget_pastel_sub"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/us_mem_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="22dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone" />
</FrameLayout>
