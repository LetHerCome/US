<?xml version="1.0" encoding="utf-8"?>
<!-- Ricordi 4x2 (widget del redesign, 26/11/2026): two polaroids on the left
     (drawn by US), on the right «Ricordi», «Un anno fa» in Fraunces and the
     place and the photos of that day. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_mem_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_w_card"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/us_mem_stack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/us_mem_content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/us_mem_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/us_figtree"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/us_widget_memories_label"
                android:textColor="@color/us_w_label"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/us_mem_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/us_mem_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/us_figtree"
                android:importantForAccessibility="no"
                android:maxLines="2"
                android:textColor="@color/us_w_sub"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/us_mem_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="18dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</FrameLayout>
