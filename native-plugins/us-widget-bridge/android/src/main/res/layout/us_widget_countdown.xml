<?xml version="1.0" encoding="utf-8"?>
<!-- Countdown 2x2, Foto protagonista (founder, 02/11/2026): always
     illustrated, a sun on the horizon. The frosted "Mancano", the number in
     Fraunces with "giorni / Lisbona" in italic beside it, the 14 ticks of the
     last two weeks. The final day: the clock that counts down by itself. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_cd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_card"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/us_cd_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/us_widget_art_countdown_s" />

    <FrameLayout
        android:id="@+id/us_cd_grain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/us_widget_grain" />

    <LinearLayout
        android:id="@+id/us_cd_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/us_cd_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/us_widget_glass_pill"
            android:ellipsize="end"
            android:fontFamily="@font/us_figtree"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/us_widget_pastel_ink"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/us_cd_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitStart" />

            <Chronometer
                android:id="@+id/us_cd_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/us_figtree"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/us_widget_pastel_ink"
                android:textSize="26sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/us_cd_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitStart" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <ImageView android:id="@+id/us_cd_tick_0" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_1" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_2" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_3" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_4" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_5" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_6" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_7" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_8" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_9" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_10" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_11" style="@style/UsWidgetTick" />
            <ImageView android:id="@+id/us_cd_tick_12" style="@style/UsWidgetTick" />
            <ImageView
                android:id="@+id/us_cd_tick_13"
                style="@style/UsWidgetTick"
                android:layout_marginEnd="0dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/us_cd_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:fontFamily="@font/us_figtree"
        android:importantForAccessibility="no"
        android:padding="16dp"
        android:textColor="@color/us_widget_pastel_ink"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
