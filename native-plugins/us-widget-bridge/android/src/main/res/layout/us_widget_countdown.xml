<?xml version="1.0" encoding="utf-8"?>
<!-- Countdown. One layout, styled per US Countdown style at render time
     (UsCountdownWidgetProvider.look): background, decoration, face, colours. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/us_cd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/us_widget_background"
    android:contentDescription="@string/us_widget_countdown_name">

    <ImageView
        android:id="@+id/us_cd_deco"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/us_cd_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.22"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/us_widget_text"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/us_cd_value_light"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="46sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/us_widget_text"
            android:textStyle="normal"
            android:visibility="gone" />
        <TextView
            android:id="@+id/us_cd_value_serif"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="46sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/us_widget_text"
            android:textStyle="italic"
            android:visibility="gone" />
        <TextView
            android:id="@+id/us_cd_value_bold"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="46sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/us_widget_text"
            android:textStyle="normal"
            android:visibility="gone" />
        <Chronometer
            android:id="@+id/us_cd_clock_light"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="30sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/us_widget_text"
            android:textStyle="normal"
            android:visibility="gone" />
        <Chronometer
            android:id="@+id/us_cd_clock_serif"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="30sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/us_widget_text"
            android:textStyle="italic"
            android:visibility="gone" />
        <Chronometer
            android:id="@+id/us_cd_clock_bold"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="30sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/us_widget_text"
            android:textStyle="normal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/us_cd_unit_serif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:textColor="@color/us_widget_text"
            android:textSize="14sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/us_cd_unit_caps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.3"
            android:textAllCaps="true"
            android:textColor="@color/us_widget_text"
            android:textSize="9sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/us_cd_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/us_widget_accent"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <TextView
            android:id="@+id/us_cd_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="3"
            android:text="@string/us_widget_countdown_empty"
            android:textColor="@color/us_widget_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
