<?xml version="1.0" encoding="utf-8"?>
<!-- Giorni insieme is now part of Foto & giorni (Pastello, 02/11/2026): hidden
     from the widget list; the ones already on a Home screen keep working. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/us_widget_photo_description"
    android:initialLayout="@layout/us_widget_photo"
    android:minWidth="110dp"
    android:minHeight="110dp"
