<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview: the generic print on top, with its white border. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <gradient android:centerColor="#FFFF7C96" android:centerX="0.25" android:centerY="0.15" android:endColor="#FF5A2F63" android:gradientRadius="150%" android:startColor="#FFFFD3A8" android:type="radial" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
