<?xml version="1.0" encoding="utf-8"?>
<!-- Countdown 2x2, Pastello: #dbeaff, #efe4ff, #ffe3ea (the board's 160deg). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="#FFEFE4FF"
        android:endColor="#FFFFE3EA"
        android:startColor="#FFDBEAFF" />
    <corners android:radius="26dp" />
</shape>
