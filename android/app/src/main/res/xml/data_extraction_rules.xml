<?xml version="1.0" encoding="utf-8"?>
<!-- US keeps the account session, widget state and private media on this phone
     only: nothing goes to cloud backup or a device-to-device transfer. A new
     phone signs in again with email and password. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
