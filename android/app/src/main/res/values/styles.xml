<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/us_splash_background</item>
        <item name="windowSplashScreenBackground">@color/us_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/us_splash_symbol</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- One splash per app theme ("Atmosfera"), coloured in values-v31: Android 13+
         uses the one the app chose last time (native-plugins/us-splash-theme). -->
    <style name="AppTheme.NoActionBarLaunch.Rose" />
    <style name="AppTheme.NoActionBarLaunch.Midnight" />
    <style name="AppTheme.NoActionBarLaunch.Film" />
    <style name="AppTheme.NoActionBarLaunch.BlueHour" />
    <style name="AppTheme.NoActionBarLaunch.Graphite" />
</resources>
