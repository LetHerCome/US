<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (never release, never the Play bundle): the Android live
     app loads its web part over plain HTTP from this PC through
     `adb reverse` (scripts/android-live.mjs), so localhost alone may be
     reached without TLS. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/us_live_network_security" />
</manifest>
