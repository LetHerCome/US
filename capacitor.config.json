{
  "appId": "com.usapp.us",
  "appName": "US",
  "webDir": "dist/capacitor",
  "android": {
    "backgroundColor": "#26142E"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#26142E",
    "allowsLinkPreview": false,
    "preferredContentMode": "mobile",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK",
      "hidden": false,
      "initialViewportFitValueHint": "cover"
    },
    "PushNotifications": {
      "presentationOptions": []
    }
  }
}
